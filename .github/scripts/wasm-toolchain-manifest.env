# Expected identity for the ghc-wasm-meta commit + flavour pinned in
# wasm.yaml/test.yaml (GHC_WASM_META_COMMIT_HASH, GHC_WASM_META_FLAVOUR).
#
# Values below are read directly from that commit's own
# ghcup-wasm-0.0.9.yaml manifest (entry wasm32-wasi-9.10.3.20250924), not
# derived from any installation being validated -- this file is the
# independent oracle validate-wasm-toolchain.sh checks against.
#
# Update this file only when GHC_WASM_META_COMMIT_HASH or
# GHC_WASM_META_FLAVOUR change, by reading the new commit's own
# ghcup-wasm-*.yaml manifest, never by copying whatever a run happens to
# install.
EXPECTED_GHC_WASM_COMMIT=c3f44696d29aaeadd755d69c51735954bfcd59db
EXPECTED_GHC_WASM_FLAVOUR=9.10
EXPECTED_GHC_NUMERIC_VERSION=9.10.3
EXPECTED_GHC_TARGET_TRIPLE=wasm32-wasi
